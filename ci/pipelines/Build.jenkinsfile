def version = "0.0.0"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']


library identifier: "cpp-jenkins-pipelines@master", retriever: modernSCM(
  [$class: "GitSCMSource",
   remote: "https://github.com/systelab/cpp-jenkins-pipelines.git"])
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	parameters
	{
		string(	name: 'version',
				description: 'Version to build (must match the name of the tag that will be checked out), leave blank for checkout of current branch',
				defaultValue: '' )

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload testing conan package',
					  defaultValue: false )
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				script 
				{
					if (params.version == '')
					{
						checkoutSourceCode()
					}
					else
					{
						checkoutSourceCodeFromTag(version)
						version = params.version
					}
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								bat "conan export-pkg WebServerAdapterInterface/ --version=${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"

								def buildFolder = "build/${config}-${arch}"
								bat "conan install ./WebServerAdapterTestUtilities --version=${version} --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"
								bat "conan build ./WebServerAdapterTestUtilities --version=${version} --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"
								bat "conan export-pkg ./WebServerAdapterTestUtilities --version=${version} --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"
								bat "conan test ./test_package web-server-adapter-test-utilities/${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat "conan upload web-server-adapter-interface/${version} --remote aid-conan-production-local --confirm --force"
					bat "conan upload web-server-adapter-test-utilities/${version} --remote aid-conan-production-local --confirm --force"
				}
			}
		}
	}
}